{"id":"sed_10","left":{"entity_name":"deploy plan v3","fact_type":"scheduled_at","claim":"19:00 JST"},"right":{"entity_name":"deploy plan v4","fact_type":"scheduled_at","claim":"21:00 JST"},"expected":false,"category":"different_entity_red_herring"}
