# KIOKU eval — same_entity_different_fact cases (15).
# Schema: kioku_eval::SameEntityDifferentFactCase.
# `expected: true` ⇒ same entity, conflicting / replacing fact ⇒ Phase 2 must
# bi-temporal record (old.valid_to=now, insert new). `expected: false` ⇒ NOT a
# conflict (different entity, or compatible additive fact).
# Categories: date_change / value_change / status_change / role_change /
# different_entity_red_herring / additive_fact / cross_lingual.

# ── date_change (expected: true) ────────────────────────────────────────
{"id":"sed_01","left":{"entity_name":"Q2 launch","fact_type":"scheduled_at","claim":"July 1"},"right":{"entity_name":"Q2 launch","fact_type":"scheduled_at","claim":"July 8"},"expected":true,"category":"date_change"}
{"id":"sed_02","left":{"entity_id":"cal_evt_003","entity_name":"Investor sync","fact_type":"scheduled_at","claim":"2026-04-25 11:00 JST"},"right":{"entity_id":"cal_evt_003","entity_name":"Investor sync","fact_type":"scheduled_at","claim":"2026-04-26 14:00 JST"},"expected":true,"category":"date_change"}

