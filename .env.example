# Clerk (macOS Tauri + system browser OAuth)
# Copy to .env in this directory and fill in values from the Clerk dashboard.
#
# Dashboard checklist:
# 1. Create/select a Clerk application.
# 2. Enable Google and X (Twitter) as social providers.
# 3. Paths → Add redirect URL: shogun-ai://clerk-callback
#    (must match CLERK_REDIRECT in src-tauri/src/auth.rs)
# 4. Copy "Publishable key" and Frontend API URL (e.g. https://xxx.clerk.accounts.dev)

CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
