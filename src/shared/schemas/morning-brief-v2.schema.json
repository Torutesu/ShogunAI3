{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shogun.ai/schemas/morning-brief-v2.json",
  "title": "MorningBrief",
  "type": "object",
  "required": ["version", "generated_at", "user_tz", "date", "summary", "items", "deferred"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "2.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "user_tz": { "type": "string" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "summary": {
      "type": "object",
      "required": ["headline", "posture", "total_meeting_minutes", "focus_blocks"],
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string" },
        "posture": { "enum": ["focus", "meeting-heavy", "recovery", "launch"] },
        "total_meeting_minutes": { "type": "number", "minimum": 0 },
        "focus_blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/time_block" }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 7,
      "items": { "$ref": "#/$defs/brief_item" }
    },
    "deferred": {
      "type": "array",
      "items": { "$ref": "#/$defs/deferred_item" }
    },
    "stub": { "type": "boolean" },
    "echo": {}
  },
  "$defs": {
    "time_block": {
      "type": "object",
      "required": ["start", "end", "duration_minutes"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "duration_minutes": { "type": "number", "minimum": 0 }
      }
    },
    "context_ref": {
      "type": "object",
      "required": ["type", "title", "uri"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["document", "person", "decision", "slack_thread", "email", "commit", "calendar"]
        },
        "title": { "type": "string" },
        "uri": { "type": "string" },
        "last_touched": { "type": "string" },
        "snippet": { "type": "string" }
      }
    },
    "next_action": {
      "type": "object",
      "required": ["verb", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "verb": { "type": "string" },
        "label": { "type": "string" },
        "type": { "enum": ["open", "draft", "execute", "schedule", "ignore"] },
        "mcp_tool": {
          "type": "object",
          "required": ["tool_name", "arguments"],
          "additionalProperties": false,
          "properties": {
            "tool_name": { "type": "string" },
            "arguments": { "type": "object" }
          }
        },
        "estimated_minutes": { "type": "number", "minimum": 0 }
      }
    },
    "brief_source": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["calendar", "kioku_search", "email", "slack", "dream_cycle", "decision_graph"]
        },
        "query": { "type": "string" },
        "upstream_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "brief_item": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "category",
        "what",
        "why_now",
        "related_context",
        "next_action",
        "source",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "priority": { "enum": [1, 2, 3] },
        "category": {
          "enum": [
            "meeting",
            "commitment",
            "followup",
            "decision",
            "review",
            "prep",
            "signal"
          ]
        },
        "what": { "type": "string" },
        "why_now": { "type": "string" },
        "related_context": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/context_ref" }
        },
        "next_action": { "$ref": "#/$defs/next_action" },
        "time_hint": { "type": "string" },
        "source": { "$ref": "#/$defs/brief_source" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "deferred_item": {
      "type": "object",
      "required": ["id", "reason", "snippet"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "reason": {
          "enum": ["low_priority_today", "blocked", "scheduled_later"]
        },
        "resurface_at": { "type": "string" },
        "snippet": { "type": "string" }
      }
    }
  }
}
