# Copy to .env and fill in. See README.md for semantics.
ANTHROPIC_API_KEY=

# Primary model for per-candidate AMC (default: claude-opus-4-7)
# ANTHROPIC_MODEL=claude-opus-4-7

# Headline + posture only (default: claude-sonnet-4-6; does not inherit ANTHROPIC_MODEL)
# ANTHROPIC_SUMMARY_MODEL=claude-sonnet-4-6

# One retry for composer on 429 / 529 if different from primary (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL_FALLBACK=claude-sonnet-4-6
