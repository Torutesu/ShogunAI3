# Clerk (same app as desktop)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Database
DATABASE_URL=postgresql://user:pass@host/shogun

# Admin
ADMIN_API_KEY=change-me-in-production

# LP waitlist webhook (server-side POST /api/waitlist only — NEVER put this
# secret in browser code; browser signups use the origin allowlist instead)
WAITLIST_WEBHOOK_SECRET=change-me-in-production
NEXT_PUBLIC_LP_ORIGIN=https://shogunai.lovable.app

# Waitlist campaign security
# Salt for HMAC-hashing signup IPs (fraud signals). Rotate = old hashes
# stop correlating with new ones; that's acceptable.
IP_HASH_SALT=change-me-in-production
# Optional Cloudflare Turnstile. Unset = check disabled (launch default);
# set both + add the widget to the LP form under bot pressure.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional per-IP hourly limits (defaults: 30 / 120 / 300)
# RATE_LIMIT_SIGNUP=30
# RATE_LIMIT_PROFILE=120
# RATE_LIMIT_STATUS=300

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_DMG_DOWNLOAD_URL=https://github.com/Torutesu/ShogunAI3/releases/latest/download/Shogun.AI_0.4.2_aarch64.dmg
