# Google OAuth 2.0 client credentials for the local OAuth helper.
# Copy this file to scripts/.env.google-oauth (gitignored) and fill in real values.
# Create these at https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth client (Web application).
# Required redirect URI: http://localhost:8723/callback

CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx

# 実行例:
#   node scripts/oauth-google.mjs
#   node scripts/oauth-google.mjs --show-secrets
#   node scripts/oauth-google.mjs --timeout-ms=120000
